#!/bin/sh
#DEBHELPER#

sysUser="ffpu"
new_install=false

# Debian calls postinst as "configure" and passes the previous version on
# upgrades. RPM uses 1 for a fresh install and 2 for an upgrade.
if { [ "$1" = "configure" ] && [ -z "$2" ]; } || [ "$1" = "1" ]; then
    new_install=true
fi

if [ -f /run/.containerenv ] || [ -f /run/.dockerenv ] || [ -f /.dockerenv ] || [ -f /.dockerinit ]; then
    sysUser="root"
fi

if [ ! $(id -u $sysUser 2>/dev/null || echo -1) -ge 0 ]; then
    adduser --system --create-home $sysUser > /dev/null || adduser --system --home "/home/$sysUser" $sysUser
fi

# Hardware video encode (h264_v4l2m2m) needs access to /dev/video*, which on
# Debian/Raspberry Pi OS is group-owned by "video" with no "other" access.
# Without this, ffmpeg fails with "Could not find a valid device" instead of
# falling back to software encode -- confirmed on a fresh install where this
# step was still missing. Idempotent and safe on upgrades too, in case an
# existing install predates this fix.
if [ "$sysUser" != "root" ] && getent group video > /dev/null 2>&1; then
    usermod -aG video "$sysUser" || true
fi

if [ ! -d "/usr/share/ffplayout/db" ]; then
    mkdir "/usr/share/ffplayout/db"
    mkdir -p "/usr/share/ffplayout/public/live"
    mkdir -p "/var/lib/ffplayout/playlists"
    mkdir -p "/var/lib/ffplayout/tv-media"

    chown -R ${sysUser}: "/usr/share/ffplayout"
    chown -R ${sysUser}: "/var/lib/ffplayout"
fi

if [ ! -d "/var/log/ffplayout" ]; then
    mkdir "/var/log/ffplayout"

    chown ${sysUser}: "/var/log/ffplayout"
fi

if [ "$new_install" = true ]; then
    cat <<'EOF'

ffplayout was installed successfully.
Open http://{IP/Domain}:8787/ in a browser and complete the initial setup.
EOF
fi
